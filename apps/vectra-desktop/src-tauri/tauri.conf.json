{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vectra",
  "version": "0.1.0",
  "identifier": "com.vectra.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vectra \u2014 untitled.vectra",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true,
        "additionalBrowserArgs": "--enable-features=Vulkan,UseSkiaRenderer --enable-unsafe-webgpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Parametric 2D design engine",
    "longDescription": "Vectra: a parametric vector design engine whose geometry is a graph. Documents are .vectra files (gzipped JSON).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
